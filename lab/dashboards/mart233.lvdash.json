      "name": "overview",
      "displayName": "Mart 233",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "## Mart 233: what do shoppers prefer?\n",
                "A made-up online shop in Ghana. Every customer, product and price is invented. Prices in Ghana cedis (GHS)."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
