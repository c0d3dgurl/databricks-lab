{
  "datasets": [
    {
      "name": "daily",
      "displayName": "Daily sales",
      "queryLines": [
        "SELECT order_date, category, orders, revenue_ghs FROM workspace.shop.gold_daily"
      ]
    },
    {
      "name": "category_city",
      "displayName": "Category by city and age band",
      "queryLines": [
        "SELECT city, age_band, category, orders, revenue_ghs, avg_rating FROM workspace.shop.gold_category_city"
      ]
    },
    {
      "name": "preferences",
      "displayName": "Customer preferences",
      "queryLines": [
        "SELECT age_band, favourite_category, count(*) AS customers ",
        "FROM workspace.shop.gold_customer_preferences GROUP BY ALL"
      ]
    },
    {
      "name": "personas",
      "displayName": "Customer personas",
      "queryLines": [
        "SELECT customer_id, name, city, age_band, persona, favourite_category, total_spend_ghs, ",
        "preferred_payment, orders, spend_tier FROM workspace.shop.gold_personas"
      ]
    }
  ],
  "pages": [
